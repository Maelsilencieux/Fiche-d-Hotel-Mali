# ============================================================
#  SafeStay — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- Serveur ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/safestay
# Exemple Atlas : mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/safestay

# --- JWT ---
JWT_SECRET=remplacez_par_une_longue_chaine_secrete_aleatoire
JWT_EXPIRE=7d

# --- JWT Police (clé séparée plus stricte) ---
JWT_POLICE_SECRET=remplacez_par_une_autre_chaine_secrete_police
JWT_POLICE_EXPIRE=1d

# --- Email (Nodemailer – ex: Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre_app_password_gmail
EMAIL_FROM="SafeStay Mali <no-reply@safestay.ml>"

# --- Upload ---
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# --- Contact : destinataire des messages du formulaire /contact ---
CONTACT_EMAIL=contact@safestay.ml

# --- Front-end (CORS) ---
CLIENT_URL=http://localhost:3000

# --- Super Admin initial (créé au démarrage si inexistant) ---
SUPERADMIN_EMAIL=superadmin@safestay.ml
SUPERADMIN_PASSWORD=SuperAdmin2026!

# --- Télé-transmission journalière (Mali = GMT) ---
# Heure de clôture (0-23) : après cette heure, un lot non scellé est « en retard »
TRANSMISSION_DEADLINE_HOUR=23
